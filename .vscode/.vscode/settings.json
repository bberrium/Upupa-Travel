{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.astro/**": true,
    "**/originals/**": true,
    "**/public/images/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.astro": true,
    "**/originals": true,
    "**/public/images": true,
    "**/package-lock.json": true
  },
  "files.exclude": {
    "**/dist": true,
    "**/.astro": true
  },
  "typescript.tsserver.maxTsServerMemory": 1536,
  "typescript.disableAutomaticTypeAcquisition": true,
  "git.autorefresh": false,
  "telemetry.telemetryLevel": "off"
}