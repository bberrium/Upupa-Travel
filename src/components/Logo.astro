---
/**
 * UPUPA Travel – neon hoopoe logo with a smooth click animation.
 *
 * Files this needs:
 *   src/components/Logo.astro                         (this file)
 *   src/lib/logo-warp.js                              (the animation maths)
 *   public/images/brand/upupa-flame/logo-transparent.webp
 *
 * The animation bends the ONE complete logo image (feathers fan out and a soft
 * ripple runs up them), so nothing is ever cut apart or crossfaded. The old
 * feather-N.webp / head.webp files are no longer used and can be deleted.
 */
import { SITE } from "../lib/site.js";

interface Props {
  href: string;
  size?: string;
  variant?: "header" | "footer";
}

const { href, size = "h-12 md:h-14", variant = "header" } = Astro.props;
const onDark = variant === "footer";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const logoSrc = `${base}images/brand/upupa-flame/logo-transparent.webp`;
---

<a
  href={href}
  class="upupa-flame-link group flex shrink-0 items-center gap-2 sm:gap-3"
  aria-label={`${SITE.name} — go to homepage`}
  data-upupa-flame="true"
>
  <span class={`upupa-flame-mark ${size}`} aria-hidden="true">
    <img
      class="upupa-flame-still"
      src={logoSrc}
      alt=""
      width="720"
      height="770"
      decoding="async"
      draggable="false"
    />
    <!-- Drawn on click only. Slightly larger than the logo so the feathers have room to fan out. -->
    <canvas class="upupa-flame-canvas"></canvas>
  </span>
  <span class="flex flex-col leading-none">
    <span
      class={`font-display font-bold tracking-[0.16em] transition-colors duration-300 ${
        onDark ? "text-white" : "text-primary"
      } text-[17px] sm:text-[20px] md:text-[23px]`}
    >
      {SITE.logo.wordmark}
    </span>
    <span class="mt-1 flex items-baseline gap-1 text-[10px] font-semibold tracking-[0.22em] sm:text-[11px]">
      <span class={onDark ? "text-white/70" : "text-secondary"}>{SITE.logo.taglineLead}</span>
      <span class={onDark ? "text-white" : "text-tertiary"}>{SITE.logo.taglineName}</span>
    </span>
  </span>
</a>

<style is:global>
  .upupa-flame-link { text-decoration: none; border-radius: 8px; --upupa-hover-scale: 1.15; /* how much the logo grows on hover */ }
  .upupa-flame-link:focus-visible { outline: 2px solid #ee2ea8; outline-offset: 5px; }
  .upupa-flame-mark {
    position: relative;
    display: inline-block;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    padding: 0;
    overflow: visible;
    background: transparent !important;
    border: 0;
    box-shadow: none;
    line-height: 0;
    transition: filter .4s ease, transform .4s cubic-bezier(.22, 1, .36, 1);
  }
  .upupa-flame-still {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }
  /* 12% bigger than the logo on every side: this is the room the feathers fan into.
     Must match `bleed` in logo-warp.js (0.12). */
  .upupa-flame-canvas {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    pointer-events: none;
    visibility: hidden;
  }
  /* Grows on hover. It stays sharp because the still image is much bigger than
     it is shown, and the click animation draws its canvas at the grown size
     (see pixelScale in the script), so nothing is stretched. */
  .upupa-flame-link:hover .upupa-flame-mark,
  .upupa-flame-link:focus-visible .upupa-flame-mark {
    transform: scale(var(--upupa-hover-scale));
    filter: drop-shadow(0 0 9px rgba(237, 52, 164, .25));
  }
  /* While playing, the canvas shows the exact same logo, bent. The still image
     is hidden under it, so the swap at the start and end is invisible. */
  .upupa-flame-link.is-playing .upupa-flame-still { visibility: hidden; }
  .upupa-flame-link.is-playing .upupa-flame-canvas { visibility: visible; }
  .upupa-flame-link.is-playing .upupa-flame-mark {
    transform: scale(var(--upupa-hover-scale)); /* same size as hover: no jump on click */
    filter: drop-shadow(0 0 10px rgba(251, 71, 153, .3));
  }
</style>

<script>
  import { createLogoWarp } from "../lib/logo-warp.js";
  import { playUpupaSound } from "../lib/logo-sound.js";

  const DURATION = 1150; // ms for the whole unfold-and-settle

  function bindUpupaFlame() {
    document.querySelectorAll<HTMLAnchorElement>('[data-upupa-flame="true"]').forEach((link) => {
      if (link.dataset.logoBound) return;
      link.dataset.logoBound = "true";

      const img = link.querySelector<HTMLImageElement>(".upupa-flame-still");
      const canvas = link.querySelector<HTMLCanvasElement>(".upupa-flame-canvas");
      let warp: ReturnType<typeof createLogoWarp> | null = null;

      link.addEventListener("click", async (event: MouseEvent) => {
        if (
          event.defaultPrevented || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !img || !canvas
        ) return;

        event.preventDefault();
        if (link.classList.contains("is-playing")) return;
        playUpupaSound(); // must run right here, inside the click, or browsers block it

        const target = new URL(link.href, window.location.href);
        const current = new URL(window.location.href);
        const samePage = target.pathname === current.pathname && target.search === current.search;
        const go = () => {
          if (samePage) window.scrollTo({ top: 0, behavior: "smooth" });
          else window.location.assign(target.href);
        };

        try {
          if (!img.complete) await img.decode();
          // Show the canvas at the logo's current on-screen size.
          canvas.style.visibility = "visible"; // so it can be measured
          // Draw at the hover size so the bitmap is never stretched (stays sharp).
          const pixelScale = parseFloat(getComputedStyle(link).getPropertyValue("--upupa-hover-scale")) || 1.15;
          if (!warp) warp = createLogoWarp(canvas, img, { bleed: 0.12, pixelScale });
          else warp.resize();
          canvas.style.visibility = "";
          warp.draw(0); // identical to the still logo, so the swap is invisible
        } catch {
          go(); // if anything goes wrong, just navigate
          return;
        }

        link.classList.add("is-playing");
        const start = performance.now();
        const tick = (now: number) => {
          const q = Math.min(1, (now - start) / DURATION);
          warp!.draw(q);
          if (q < 1) {
            requestAnimationFrame(tick);
          } else {
            link.classList.remove("is-playing");
            go();
          }
        };
        requestAnimationFrame(tick);
      });
    });
  }

  bindUpupaFlame();
  document.addEventListener("astro:page-load", bindUpupaFlame);
</script>