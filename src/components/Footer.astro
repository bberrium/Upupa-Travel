---
import Logo from "./Logo.astro";
import { SITE, SOCIAL_LINKS } from "../lib/site.js";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="bg-primary text-on-primary">
  <div class="container-page grid grid-cols-1 gap-stack-lg py-14 md:grid-cols-3">
    
    <!-- Column 1: Logo and Description -->
    <div class="md:col-span-1">
      <Logo href={base} size="h-14" variant="footer" />
      <div class="h-4"></div>
    </div>

    <!-- Column 2: Explore Links -->
    <div>
      <h3 class="mb-4 text-label-md font-label-md uppercase tracking-widest text-white/60">Explore</h3>
      <ul class="space-y-2.5">
        <li><a class="text-white/80 transition-colors hover:text-white" href={`${base}tours/day-tours`}>Day Tours</a></li>
        <li><a class="text-white/80 transition-colors hover:text-white" href={`${base}tours/multi-day-tours`}>Multi-Day Tours</a></li>
        <li><a class="text-white/80 transition-colors hover:text-white" href={`${base}custom-tour`}>Custom Tours</a></li>
        <li><a class="text-white/80 transition-colors hover:text-white" href={`${base}private-transfer`}>Private Transfers</a></li>
        <li><a class="text-white/80 transition-colors hover:text-white" href={`${base}gallery`}>Gallery</a></li>
      </ul>
    </div>

    <!-- Column 3: Contact & Mascot -->
    <div>
      <h3 class="mb-4 text-label-md font-label-md uppercase tracking-widest text-white/60">Contact</h3>
      <ul class="space-y-2.5">
        <li><a class="text-white/80 transition-colors hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>
          <a
            class="inline-flex items-center gap-2 text-white/80 transition-colors hover:text-white"
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            WhatsApp {SITE.phoneDisplay}
          </a>
        </li>
        <li><a class="text-white/80 transition-colors hover:text-white" href={`tel:${SITE.phoneE164}`}>Call {SITE.phoneDisplay}</a></li>
        
        <li class="relative pt-1 text-white/60 w-max">
          {SITE.city}, Armenia
          <img 
            src={`${base}images/mascot.png`} 
            alt="Upupa Travel Mascot" 
            width="55" 
            class="mt-4 drop-shadow-md transition-transform duration-300 hover:scale-110 md:absolute md:-bottom-2 md:-right-20 md:mt-0"
          />
        </li>
      </ul>

      {SOCIAL_LINKS.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-4">
          {SOCIAL_LINKS.map((link) => (
            <a
              class="text-label-md font-label-md text-white/80 underline-offset-4 transition-colors hover:text-white hover:underline"
              href={link.href}
              target="_blank"
              rel="noopener"
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>

  </div> <!-- This closing div for the grid container was missing! -->

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-5 text-caption font-caption text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <div class="flex gap-5">
        <a class="underline-offset-4 transition-colors hover:text-white hover:underline" data-t="footer_privacy" href={`${base}privacy`}>Privacy Policy</a>
        <a class="underline-offset-4 transition-colors hover:text-white hover:underline" data-t="footer_terms" href={`${base}terms`}>Terms & Booking Conditions</a>
      </div>
    </div>
  </div>
</footer>