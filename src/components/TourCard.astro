---
const { tour } = Astro.props;
const carouselId = `carousel-${tour.slug}`;
---

<div class="border border-gray-200 rounded-xl overflow-hidden max-w-sm relative group bg-white shadow-sm hover:shadow-md transition-shadow">
  
  <!-- Slideshow Section -->
  <div class="relative h-56 w-full">
    <!-- Prev Button -->
    <button class="nav-btn prev absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/70 text-white p-2 rounded-full opacity-0 group-hover:opacity-100 transition-all z-10" data-target={carouselId}>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    </button>

    <!-- Carousel Container -->
    <div id={carouselId} class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar h-full w-full">
      {tour.images.map((img) => (
        <div class="min-w-full snap-center h-full">
          <img src={img} alt={tour.title} loading="lazy" class="w-full h-full object-cover" />
        </div>
      ))}
    </div>

    <!-- Next Button -->
    <button class="nav-btn next absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/70 text-white p-2 rounded-full opacity-0 group-hover:opacity-100 transition-all z-10" data-target={carouselId}>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
    </button>
  </div>

  <!-- Tour Info -->
  <div class="p-5">
    <span class="text-xs font-semibold tracking-wider text-gray-500 uppercase">{tour.label}</span>
    <h3 class="text-lg font-bold text-gray-900 mt-1 mb-2 line-clamp-1">{tour.title}</h3>
    <p class="text-sm text-gray-600 mb-4 line-clamp-2">{tour.desc}</p>
    <a href={`/tours/${tour.slug}`} class="text-[#03adfc] text-sm font-semibold hover:underline">
      View details &rarr;
    </a>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll('.nav-btn');
  
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const carousel = document.getElementById(targetId);
      
      if (carousel) {
        const slideWidth = carousel.clientWidth;
        if (btn.classList.contains('next')) {
          carousel.scrollBy({ left: slideWidth, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: -slideWidth, behavior: 'smooth' });
        }
      }
    });
  });
</script>

<style>
  /* Hides the scrollbar but keeps functionality */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>