---
// Server-rendered tour card. Rendering on the server (instead of building the
// markup in a client script) means the tours are in the HTML: search engines
// index them, and they show up even if JavaScript fails.
import Picture from "./Picture.astro";
import { priceFor, formatAMD, approxUSD } from "../data/tours.js";

interface Props {
  tour: any;
  eager?: boolean;
}
const { tour, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}tours/${tour.slug}`;

// Rendered price is the no-guide price for 2 people; the client script updates
// it as soon as the visitor changes the search controls.
const initial = priceFor(tour.pricing, 2, false);
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-border-muted bg-surface-container-lowest shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover motion-reduce:hover:translate-y-0"
  data-tour-card
  data-slug={tour.slug}
  data-category={tour.category}
  data-languages={(tour.languages || []).join(",")}
  data-pricing={JSON.stringify(tour.pricing)}
>
  <a href={href} class="relative block h-56 overflow-hidden bg-surface-container sm:h-64 group/slide" aria-label={`View the ${tour.title} itinerary`}>
    
    {tour.images?.map((img: string, index: number) => (
      <div class={`card-slide absolute inset-0 h-full w-full transition-opacity duration-700 ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}>
        <Picture
          src={img}
          alt={tour.title}
          width={800}
          height={600}
          loading={eager && index === 0 ? "eager" : "lazy"}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
          sizes="(max-width: 768px) 100vw, 400px"
        />
      </div>
    ))}

    <span class="absolute left-4 top-4 z-20 rounded-full bg-secondary px-3 py-1 text-caption font-caption tracking-wide text-white">
      {tour.tourNumber ? `Tour ${tour.tourNumber}` : tour.label}
    </span>
    
    {tour.images && tour.images.length > 1 && (
      <div class="absolute bottom-3 left-1/2 z-30 flex -translate-x-1/2 gap-1.5 pointer-events-auto">
        {tour.images.map((_: any, index: number) => (
          <button type="button" class={`card-dot h-1.5 rounded-full transition-all duration-500 ${index === 0 ? "w-6 bg-white" : "w-1.5 bg-white/50"}`} data-index={index} aria-label={`Slide ${index + 1}`}></button>
        ))}
      </div>
    )}

    <span class="pointer-events-none absolute inset-0 z-20 bg-gradient-to-t from-black/45 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
  </a>

  <div class="flex flex-grow flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-caption font-caption uppercase tracking-wide text-on-surface-variant">
      {tour.duration && (
        <span class="inline-flex items-center gap-1">
          <span class="material-symbols-outlined text-[15px]">schedule</span>{tour.duration}
        </span>
      )}
      {tour.region && (
        <span class="inline-flex items-center gap-1">
          <span class="material-symbols-outlined text-[15px]">location_on</span>from {tour.region}
        </span>
      )}
    </div>

    <h3 class="font-display text-headline-sm font-headline-sm text-primary transition-colors group-hover:text-secondary">
      <a href={href}>{tour.title}</a>
    </h3>

    <p class="mt-2 flex-grow text-body-md text-on-surface-variant">{tour.desc}</p>

    <div class="mt-5 flex items-end justify-between gap-4 border-t border-border-muted pt-4">
      <div>
        <p class="text-caption font-caption uppercase tracking-wide text-on-surface-variant" data-price-label>
          Total for 2 persons
        </p>
        <p class="text-headline-sm font-headline-sm text-primary" data-price-value>
          {initial ? formatAMD(initial) : "Contact for price"}
        </p>
        {initial && (
          <p class="text-caption font-caption text-on-surface-variant" data-price-usd>{approxUSD(initial)} approx.</p>
        )}
      </div>
      <a href={href} class="inline-flex items-center gap-1 text-label-md font-label-md uppercase tracking-widest text-secondary hover:text-pomegranate transition-colors cursor-pointer relative z-10">
        Details <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">arrow_forward</span>
      </a>
    </div>
  </div>
</article>

<script>
  // Astro automatically bundles this script and runs it once on the client page
  function initTourCards() {
    const cards = document.querySelectorAll("[data-tour-card]");
    
    cards.forEach((card) => {
      const slides = Array.from(card.querySelectorAll(".card-slide"));
      const dots = Array.from(card.querySelectorAll(".card-dot"));
      if (slides.length <= 1) return;

      let current = 0;
      let timer: number | undefined;

      function showSlide(next: number) {
        slides[current].classList.replace("opacity-100", "opacity-0");
        slides[current].classList.replace("z-10", "z-0");
        if (dots[current]) {
          dots[current].classList.remove("w-6", "bg-white");
          dots[current].classList.add("w-1.5", "bg-white/50");
        }

        current = next;

        slides[current].classList.replace("opacity-0", "opacity-100");
        slides[current].classList.replace("z-0", "z-10");
        if (dots[current]) {
          dots[current].classList.remove("w-1.5", "bg-white/50");
          dots[current].classList.add("w-6", "bg-white");
        }
      }

      function start() {
        if (timer) clearInterval(timer);
        timer = window.setInterval(() => showSlide((current + 1) % slides.length), 1500);
      }

      function stop() {
        if (timer) clearInterval(timer);
        timer = undefined;
      }

      // Only cycle while the card is hovered — otherwise it sits on a single
      // still image. Reset back to the first slide when the pointer leaves.
      card.addEventListener("mouseenter", start);
      card.addEventListener("focusin", start);
      card.addEventListener("mouseleave", () => {
        stop();
        if (current !== 0) showSlide(0);
      });
      card.addEventListener("focusout", () => {
        stop();
        if (current !== 0) showSlide(0);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.preventDefault(); // Prevents the link from triggering when clicking a dot
          stop();
          showSlide(parseInt((dot as HTMLElement).dataset.index || "0", 10));
          start();
        });
      });
    });
  }

  // Run initialization
  initTourCards();
</script>