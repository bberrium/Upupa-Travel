---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found — Upupa Travel" noindex>
  <section class="container-page flex min-h-[55vh] max-w-2xl flex-col items-center justify-center py-20 text-center">
    <span class="material-symbols-outlined text-[48px] text-secondary">explore_off</span>
    <h1 class="font-display mt-4 text-display-lg-mobile font-display-lg text-primary">
      This road doesn't lead anywhere
    </h1>
    <p class="mt-4 text-body-lg text-on-surface-variant">
      The page you were looking for has moved or never existed. The tours are all still here.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn-primary" href={base}>Back to the homepage</a>
      <a class="btn-outline" href={`${base}tours/day-tours`}>Browse day tours</a>
    </div>
  </section>
</BaseLayout>
