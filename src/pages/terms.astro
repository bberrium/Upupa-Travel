---
// TEMPLATE — fill in the bracketed values and have it checked by someone who
// knows Armenian consumer law before you take deposits against it. It exists
// because the site promises "a small deposit locks your date" and, until now,
// linked that promise to nothing.
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site.js";

const updated = "15 September 2026";

const sections = [
  {
    title: "1. Who we are",
    body: [
      `${SITE.legalName} is a private tour and transfer service based in ${SITE.city}, Armenia. You can reach us at ${SITE.email} or on WhatsApp at ${SITE.phoneDisplay}.`,
    ],
  },
  {
    title: "2. Booking and confirmation",
    body: [
      "Sending an enquiry does not create a booking. We reply with availability and a written total price for your group.",
      "A booking is confirmed only once you accept that price in writing and we receive the deposit.",
    ],
  },
  {
    title: "3. Prices",
    body: [
      "All prices are quoted in Armenian dram (AMD) as a total for the whole group, not per person. Any figure shown in another currency is an approximate conversion for guidance only.",
      "The price we confirm in writing is the price you pay. Entrance fees listed as included will not be charged again on the day.",
    ],
  },
  {
    title: "4. Deposit and payment",
    body: [
      "A deposit of [X]% of the total confirms the date. The balance is payable on the day of the tour, in cash (AMD), by card, or by bank transfer agreed in advance.",
      "Deposits are accepted by [bank transfer / card link / other]. We never ask for card details by message or email.",
    ],
  },
  {
    title: "5. Changes and cancellation by you",
    body: [
      "Cancelled more than [X] days before the tour: deposit refunded in full.",
      "Cancelled between [X] and [Y] days before: deposit retained, no further charge.",
      "Cancelled less than [Y] days before, or no-show: [X]% of the total is payable.",
      "Date changes are free if requested more than [X] days ahead and we have availability.",
    ],
  },
  {
    title: "6. Changes and cancellation by us",
    body: [
      "If we cancel for any reason — vehicle failure, driver illness, road closure — you are offered another date or a full refund, including the deposit.",
      "Routes may be reordered on the day for weather, road or site-closure reasons. If a listed site cannot be visited at all, we substitute a comparable one or refund the entrance fee.",
    ],
  },
  {
    title: "7. Weather and road conditions",
    body: [
      "Mountain roads can close in winter at short notice. Where a route becomes unsafe we will propose an alternative; if none is acceptable to you, the booking is treated as cancelled by us.",
    ],
  },
  {
    title: "8. Your responsibilities",
    body: [
      "Be at the agreed pickup point at the agreed time. We wait up to [X] minutes.",
      "Tell us in advance about mobility needs, medical conditions, allergies and child seats so we can plan properly.",
      "Travel insurance is your responsibility and we strongly recommend it.",
    ],
  },
  {
    title: "9. Liability",
    body: [
      "We are liable for the services we provide directly. We are not liable for loss or injury caused by third parties, by conditions outside our control, or by a guest ignoring safety instructions given by the guide or driver.",
      "Nothing here limits any right you have under applicable Armenian law.",
    ],
  },
  {
    title: "10. Complaints",
    body: [
      `If something goes wrong, tell the guide or driver on the day so it can be fixed, and write to ${SITE.email} within 14 days. We respond to every complaint in writing.`,
    ],
  },
];
---

<BaseLayout
  title="Terms & Booking Conditions — Upupa Travel"
  current="contact"
  description="Booking, deposit, payment and cancellation conditions for Upupa Travel private tours and transfers in Armenia."
>
  <article class="container-page max-w-3xl py-14 md:py-20">
    <span class="eyebrow">Legal</span>
    <h1 class="font-display text-display-lg-mobile font-display-lg text-primary">Terms &amp; Booking Conditions</h1>
    <p class="mt-3 text-caption font-caption uppercase tracking-wide text-on-surface-variant">
      Last updated {updated}
    </p>

    <div class="mt-10 space-y-9">
      {sections.map((section) => (
        <section>
          <h2 class="font-display text-headline-sm font-headline-sm text-primary">{section.title}</h2>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-body-md text-on-surface-variant">{paragraph}</p>
          ))}
        </section>
      ))}
    </div>

    <p class="mt-12 border-t border-border-muted pt-6 text-body-md text-on-surface-variant">
      Questions about any of this? Email
      <a class="text-secondary underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </article>
</BaseLayout>
