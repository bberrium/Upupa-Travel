---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PHOTOS } from "../data/photos.js";
import { image } from "../lib/images.js";

// Resolved at build time so paths work under the site base and .webp is used
// where available.
const photos = PHOTOS.map((photo) => ({ ...photo, ...image(photo.src) }));

const filters = [
  { key: "all", label: "All" },
  { key: "landscapes", label: "Landscapes" },
  { key: "monasteries", label: "Monasteries" },
  { key: "cities", label: "Cities" },
  { key: "culture", label: "Culture" },
];
---

<BaseLayout
  title="Gallery — Upupa Travel"
  current="gallery"
  description="Photos from Upupa Travel's private tours across Armenia — monasteries, mountains, lakes and local culture."
>
  <header class="container-page max-w-3xl pb-8 pt-14 text-center">
    <span class="eyebrow">Photo Gallery</span>
    <h1 class="font-display text-display-lg-mobile font-display-lg text-balance text-primary md:text-display-lg">
      Armenia Through Our Lens
    </h1>
    <div class="mx-auto my-5 h-1 w-12 rounded-full bg-secondary"></div>
    <p class="text-body-md text-on-surface-variant">
      Monasteries carved into cliffs, alpine lakes, vineyards and the peaks of the Caucasus — moments
      from our tours across Armenia.
    </p>
  </header>

  <div class="container-page flex flex-wrap justify-center gap-2 pb-8" id="g-filters" role="group" aria-label="Filter photos">
    {filters.map((filter, index) => (
      <button type="button" class="chip" data-cat={filter.key} aria-pressed={index === 0 ? "true" : "false"}>
        {filter.label}
      </button>
    ))}
  </div>

  <section class="container-page g-grid pb-24" id="g-grid">
    {photos.map((photo, index) => (
      <button type="button" class="g-item" data-cat={photo.cat} data-index={index} aria-label={`Open ${photo.cap}`}>
        <picture>
          {photo.webp && <source srcset={photo.webp} type="image/webp" />}
          <img src={photo.src} alt={photo.cap} width="900" height="600" loading="lazy" decoding="async" />
        </picture>
        <span class="g-cap">{photo.cap}</span>
      </button>
    ))}
  </section>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button class="lb-btn lb-close" type="button" aria-label="Close">×</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">‹</button>
    <img id="lb-img" src="" alt="" />
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">›</button>
    <p class="lb-cap" id="lb-cap"></p>
  </div>
</BaseLayout>

<style>
  .g-grid {
    columns: 3 260px;
    column-gap: 0.9rem;
  }
  .g-item {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin: 0 0 0.9rem;
    border-radius: 0.75rem;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    background: theme("colors.surface-container");
    padding: 0;
    border: 0;
    text-align: left;
  }
  .g-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
  }
  .g-item:hover img {
    transform: scale(1.04);
  }
  .g-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.55));
    opacity: 0;
    transition: opacity 0.3s;
  }
  .g-item:hover::after,
  .g-item:focus-visible::after {
    opacity: 1;
  }
  .g-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.85rem 1rem;
    color: #fff;
    font-family: "Source Serif 4", ui-serif, Georgia, serif;
    font-size: 0.95rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s, transform 0.3s;
    z-index: 1;
  }
  .g-item:hover .g-cap,
  .g-item:focus-visible .g-cap {
    opacity: 1;
    transform: none;
  }

  #lightbox {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0, 0, 0, 0.92);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    display: none;
  }
  #lightbox.open {
    display: flex;
  }
  #lightbox img {
    max-width: 92vw;
    max-height: 84vh;
    border-radius: 0.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    cursor: pointer;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .lb-close {
    top: 1.5rem;
    right: 1.5rem;
  }
  .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-cap {
    position: absolute;
    bottom: 1.5rem;
    left: 0;
    right: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  @media (max-width: 640px) {
    .g-grid {
      columns: 2 150px;
    }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".g-item"));
  const chips = Array.from(document.querySelectorAll<HTMLElement>(".chip"));
  const lightbox = document.getElementById("lightbox") as HTMLElement | null;
  const lightboxImg = document.getElementById("lb-img") as HTMLImageElement | null;
  const lightboxCap = document.getElementById("lb-cap");

  let visible = items.slice();
  let index = 0;
  let lastFocused: HTMLElement | null = null;

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((other) => other.setAttribute("aria-pressed", String(other === chip)));
      const category = chip.dataset.cat;
      items.forEach((item) => {
        const match = category === "all" || item.dataset.cat === category;
        item.classList.toggle("hidden", !match);
      });
      visible = items.filter((item) => !item.classList.contains("hidden"));
    });
  });

  function show() {
    const item = visible[index];
    const img = item?.querySelector("img");
    if (!img || !lightboxImg) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    if (lightboxCap) lightboxCap.textContent = img.alt;
  }

  function open(item: HTMLElement) {
    index = visible.indexOf(item);
    lastFocused = item;
    show();
    lightbox?.removeAttribute("hidden");
    lightbox?.classList.add("open");
    (lightbox?.querySelector(".lb-close") as HTMLElement | null)?.focus();
  }

  function close() {
    lightbox?.classList.remove("open");
    lightbox?.setAttribute("hidden", "");
    lastFocused?.focus();
  }

  function step(delta: number) {
    if (!visible.length) return;
    index = (index + delta + visible.length) % visible.length;
    show();
  }

  items.forEach((item) => item.addEventListener("click", () => open(item)));
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) close();
  });
  lightbox?.querySelector(".lb-close")?.addEventListener("click", close);
  lightbox?.querySelector(".lb-prev")?.addEventListener("click", () => step(-1));
  lightbox?.querySelector(".lb-next")?.addEventListener("click", () => step(1));

  document.addEventListener("keydown", (event) => {
    if (!lightbox?.classList.contains("open")) return;
    if (event.key === "Escape") close();
    if (event.key === "ArrowLeft") step(-1);
    if (event.key === "ArrowRight") step(1);
  });
</script>
