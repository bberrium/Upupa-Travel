<script>
  // --- Interactive Review Stars Logic ---
  const ratingInput = document.getElementById('review-rating');
  const stars = document.querySelectorAll('.star-btn');

  if (ratingInput && stars.length > 0) {
    stars.forEach((star, index) => {
      star.addEventListener('click', () => {
        const ratingValue = index + 1;
        ratingInput.value = ratingValue;
        
        stars.forEach((s, i) => {
          if (i < ratingValue) {
            s.style.fontVariationSettings = '"FILL" 1';
            s.classList.add('text-secondary-container');
            s.classList.remove('text-white/40');
          } else {
            s.style.fontVariationSettings = '"FILL" 0';
            s.classList.add('text-white/40');
            s.classList.remove('text-secondary-container');
          }
        });
      });
    });
  }
</script>