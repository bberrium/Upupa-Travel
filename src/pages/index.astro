---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOURS, priceFor, formatAMD } from "../data/tours.js";

const base = import.meta.env.BASE_URL;

// Add your 4 image URLs here:
const HERO_IMAGES = [
  `${base}images/cathedral.png`,
  `${base}images/church.png`,
  `${base}images/hall.png`,
  `${base}images/aram-YHW3oGai3Dg-unsplash.jpg`,
  `${base}images/ani1.jpg`,
  `${base}images/ani2.jpg`,
  `${base}images/levon-vardanyan-9KG32efejAo-unsplash.jpg`,
  `${base}images/ani3.jpg`,
  `${base}images/alex.jpg`
];
---

<BaseLayout title="Upupa Travel — Private Guides in Armenia" current="home">
<!-- Hero Section -->
<section class="relative h-[85vh] flex items-center overflow-hidden">
  <!-- Carousel Background Images -->
  <div class="absolute inset-0 z-0" id="hero-carousel">
    <div class="absolute inset-0 bg-black/40 z-10"></div>
      {HERO_IMAGES.map((imgUrl, index) => (
        <img
          src={imgUrl}
          alt="Armenia Travel"
          fetchpriority={index === 0 ? "high" : "auto"}
          loading={index === 0 ? "eager" : "lazy"}
          decoding={index === 0 ? "sync" : "async"}
          class={`hero-slide absolute inset-0 w-full h-full object-cover [image-rendering:crisp-edges] ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
        />
      ))}
  </div>

  <div class="relative z-20 w-full px-margin-desktop max-w-container-max mx-auto">
    <div class="max-w-3xl">
      <h1 class="text-white text-display-lg-mobile md:text-display-lg font-display-lg mb-stack-md leading-tight text-glow" style="font-family: 'Source Serif 4', serif;" data-t="hero_title">Travel boldly with Upupa</h1>
      <div class="flex flex-wrap gap-4">
        <a class="bg-secondary text-white px-8 py-4 rounded-lg font-bold hover:bg-secondary/90 transition-all flex items-center gap-2" href="#tours">
          <span data-t="hero_cta_explore" class="">Explore Tours</span> <span class="material-symbols-outlined">arrow_forward</span>
        </a>
        <a class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-8 py-4 rounded-lg font-bold hover:bg-white/20 transition-all" data-t="hero_cta_story" href="#about">
          Our Story
        </a>
      </div>
    </div>

    <div class="flex gap-2 mt-10" id="hero-dots">
      {HERO_IMAGES.map((_, index) => (
        <button
          type="button"
          class={`hero-dot h-1.5 rounded-full transition-all duration-500 ${index === 0 ? 'w-8 bg-white' : 'w-1.5 bg-white/40 hover:bg-white/70'}`}
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>

<!-- Category Quick-links -->
<div class="absolute bottom-0 left-0 right-0 z-30 transform translate-y-1/2 hidden md:block">
<div class="max-w-container-max mx-auto px-margin-desktop">
<div class="grid grid-cols-4 gap-6" id="category-grid">
<!-- Box 1 -->
<a class="block bg-surface shadow-xl rounded-xl border border-outline-variant hover:-translate-y-2 hover:scale-105 transition-all duration-300 cursor-pointer h-64 relative overflow-hidden group/card" href="#tours">
<div class="relative z-20 h-full flex flex-col p-6">
<h3 class="font-headline-md text-primary mb-2 text-2xl leading-tight" data-t="cat_1_title">Day Tours</h3>
<p class="text-on-surface-variant text-sm" data-t="cat_1_desc">One-day private trips across Armenia.</p>
<div class="mt-auto h-28 -mx-6 -mb-6 overflow-hidden">
<img alt="Day Tours" class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-110" src={`${base}images/hp1.jpg`}>
</div>
</div>
</a>
<!-- Box 2 -->
<a class="block bg-surface shadow-xl rounded-xl border border-outline-variant hover:-translate-y-2 hover:scale-105 transition-all duration-300 cursor-pointer h-64 relative overflow-hidden group/card" href="#tours">
<div class="relative z-20 h-full flex flex-col p-6">
<h3 class="font-headline-md text-primary mb-2 text-2xl leading-tight" data-t="cat_2_title">Multi-Day</h3>
<p class="text-on-surface-variant text-sm" data-t="cat_2_desc">Explore heritage in depth over 2-4 days.</p>
<div class="mt-auto h-28 -mx-6 -mb-6 overflow-hidden">
<img alt="Multi-Day" class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-110" src={`${base}images/hp2.jpg`}>
</div>
</div>
</a>
<!-- Box 3 -->
<a class="block bg-surface shadow-xl rounded-xl border border-outline-variant hover:-translate-y-2 hover:scale-105 transition-all duration-300 cursor-pointer h-64 relative overflow-hidden group/card" href={`${base}custom-tour`}>
<div class="relative z-20 h-full flex flex-col p-6">
<h3 class="font-headline-md text-primary mb-2 text-2xl leading-tight" data-t="cat_3_title">Custom</h3>
<p class="text-on-surface-variant text-sm" data-t="cat_3_desc">Routes built around your specific dates.</p>
<div class="mt-auto h-28 -mx-6 -mb-6 overflow-hidden">
<img alt="Custom" class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-110" src={`${base}images/hp3.jpg`}>
</div>
</div>
</a>
<!-- Box 4 -->
<a class="block bg-surface shadow-xl rounded-xl border border-outline-variant hover:-translate-y-2 hover:scale-105 transition-all duration-300 cursor-pointer h-64 relative overflow-hidden group/card" href={`${base}private-transfer`}>
<div class="relative z-20 h-full flex flex-col p-6">
<h3 class="font-headline-md text-primary mb-2 text-2xl leading-tight" data-t="cat_4_title">Transfers</h3>
<p class="text-on-surface-variant text-sm" data-t="cat_4_desc">Private drivers &amp; airport shuttle services.</p>
<div class="mt-auto h-28 -mx-6 -mb-6 overflow-hidden">
<img alt="Transfers" class="w-full h-full object-cover transition-transform duration-500 group-hover/card:scale-110" src={`${base}images/ararat1.jpg`}>
</div>
</div>
</a>
</div>
</div>
</div>
</section>

<!-- Minimalist About Section -->
<section class="bg-primary text-white py-20 relative overflow-hidden" id="about">
  <div class="max-w-container-max mx-auto px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Single Clean Hero Photo -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-white/10">
          <img 
            alt="Armenian Mountain Landscape" 
            class="w-full h-[400px] md:h-[480px] object-cover" 
            src="https://traveltoarmenia.am/wp-content/uploads/2019/02/AdobeStock_196618948-1024x677.jpeg"
          >
        </div>
      </div>

      <!-- Minimalist Content Column -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <span class="text-secondary-container font-label-md text-xs tracking-widest uppercase font-bold mb-2" data-t="about_subtitle">
          Who We Are
        </span>

        <h2 class="text-3xl md:text-4xl font-display-lg font-bold mb-6 text-white leading-tight" style="font-family: 'Source Serif 4', serif;" data-t="about_title">
          About Upupa Travel
        </h2>

        <p class="text-white/80 text-body-lg leading-relaxed mb-8" data-t="about_desc">
          Upupa Travel is a private guide service based in Yerevan. We design personal day trips and multi-day journeys to Armenia's ancient monasteries, volcanic highlands, and hidden valleys — planned around you, and led by guides who grew up here.
        </p>

        <!-- Streamlined Minimal Highlights -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary-container text-xl">language</span>
            <span class="text-white/90 text-sm font-medium">Local, native guides (English, Russian, Armenian)</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary-container text-xl">groups</span>
            <span class="text-white/90 text-sm font-medium">Small, private groups tailored to your rhythm</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary-container text-xl">map</span>
            <span class="text-white/90 text-sm font-medium">Custom-built itineraries based on your interests</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>


<!-- Tours & Packages Section -->
<section class="py-section-padding px-margin-desktop max-w-container-max mx-auto mt-20" id="tours">
<div class="text-center mb-16">
<span class="text-secondary font-label-md text-label-md tracking-widest uppercase mb-2 block" data-t="tours_subtitle">Curated Experiences</span>
<h2 class="text-headline-md font-headline-md text-primary mb-4" style="font-family: 'Source Serif 4', serif;" data-t="tours_title">Tours &amp; Packages</h2>
<div class="w-12 h-1 bg-secondary mx-auto mb-6"></div>
<p class="text-on-surface-variant max-w-2xl mx-auto text-body-md" data-t="tours_desc">Discover the heart of Armenia through our specialized language-inclusive routes.</p>
</div>

<!-- Search / Filter Bar -->
<div class="flex flex-wrap gap-6 justify-center mb-12" id="tours-search">
  <!-- Box 1: People -->
  <div class="bg-surface-container-low border border-border-muted rounded-lg p-6">
    <label class="block text-label-md font-label-md text-primary uppercase mb-3">Number of people</label>
    <div class="flex items-center gap-2">
      <button type="button" id="ts-minus" class="w-9 h-9 border border-border-muted text-primary hover:bg-surface-container transition-colors" aria-label="Decrease">−</button>
      <input id="ts-people" type="number" min="1" max="20" value="2" class="w-14 text-center border border-border-muted rounded p-2 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
      <button type="button" id="ts-plus" class="w-9 h-9 border border-border-muted text-primary hover:bg-surface-container transition-colors" aria-label="Increase">+</button>
    </div>
  </div>

  <!-- Box 2: Unified Guide & Language Dropdown -->
  <div class="bg-surface-container-low border border-border-muted rounded-lg p-6 min-w-[220px]">
    <label class="block text-label-md font-label-md text-primary uppercase mb-3">Guide</label>
    <select id="ts-guide-lang" class="border border-border-muted rounded p-2.5 w-full bg-white text-primary font-medium focus:ring-2 focus:ring-secondary focus:outline-none">
      <option value="noGuide">No guide</option>
      <option value="en">🇬🇧 English</option>
      <option value="ru">🇷🇺 Russian</option>
      <option value="am">🇦🇲 Armenian</option>
    </select>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="tours-grid"></div>
</section>

<script>
  import { TOURS, priceFor, formatAMD } from "../data/tours.js";
  const base = import.meta.env.BASE_URL;

  const grid = document.getElementById("tours-grid");
  const peopleInput = document.getElementById("ts-people");
  const minusBtn = document.getElementById("ts-minus");
  const plusBtn = document.getElementById("ts-plus");
  const guideLangSelect = document.getElementById("ts-guide-lang");

  // Background Hero Carousel
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let currentSlide = 0;
  let heroTimer = null;

  function goToSlide(next) {
    slides[currentSlide].classList.remove('opacity-100', 'kb-active');
    slides[currentSlide].classList.add('opacity-0');
    if (dots[currentSlide]) {
      dots[currentSlide].classList.remove('w-8', 'bg-white');
      dots[currentSlide].classList.add('w-1.5', 'bg-white/40');
    }

    currentSlide = next;

    slides[currentSlide].classList.remove('opacity-0');
    slides[currentSlide].classList.add('opacity-100');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      slides[currentSlide].classList.add('kb-active');
    }));
    if (dots[currentSlide]) {
      dots[currentSlide].classList.remove('w-1.5', 'bg-white/40');
      dots[currentSlide].classList.add('w-8', 'bg-white');
    }
  }

  function startHeroTimer() {
    heroTimer = setInterval(() => {
      goToSlide((currentSlide + 1) % slides.length);
    }, 5000);
  }

  if (slides.length > 1) {
    slides[0].classList.add('kb-active');
    startHeroTimer();

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        clearInterval(heroTimer);
        goToSlide(parseInt(dot.dataset.index, 10));
        startHeroTimer();
      });
    });
  }

  // Category staggered reveal
  function staggerReveal(container, step = 90) {
    if (!container) return;
    const kids = Array.from(container.children);
    kids.forEach((el, i) => {
      el.classList.add('stagger-item');
      el.style.transitionDelay = `${i * step}ms`;
    });
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          kids.forEach((el) => el.classList.add('stagger-in'));
          obs.disconnect();
        }
      });
    }, { threshold: 0.15 });
    io.observe(container);
  }
  staggerReveal(document.getElementById('category-grid'));

  // Auto-advancing slideshows for each tour card. Timers are tracked so they
  // can be torn down before every re-render (filter change) — otherwise old
  // intervals pile up and keep firing against DOM nodes that no longer exist.
  let cardTimers = [];
  function clearCardTimers() {
    cardTimers.forEach((id) => clearInterval(id));
    cardTimers = [];
  }
  function initCardSlideshow(card) {
    const slides = Array.from(card.querySelectorAll(".card-slide"));
    const dots = Array.from(card.querySelectorAll(".card-dot"));
    if (slides.length === 0) return;

    let idx = 0;
    function show(next) {
      slides[idx].classList.replace("opacity-100", "opacity-0");
      dots[idx]?.classList.remove("w-6", "bg-white");
      dots[idx]?.classList.add("w-1.5", "bg-white/50");
      idx = next;
      slides[idx].classList.replace("opacity-0", "opacity-100");
      dots[idx]?.classList.remove("w-1.5", "bg-white/50");
      dots[idx]?.classList.add("w-6", "bg-white");
    }

    // If an image 404s or is blocked by hotlink protection, drop it from
    // rotation instead of leaving a broken-image icon on screen.
    slides.forEach((slide, i) => {
      slide.addEventListener("error", () => {
        slide.classList.add("hidden");
        dots[i]?.classList.add("hidden");
        if (i === idx) {
          const next = slides.findIndex((s, j) => j !== i && !s.classList.contains("hidden"));
          if (next !== -1) show(next);
        }
      });
    });

    if (slides.length <= 1) return;

    const timer = setInterval(() => {
      let next = (idx + 1) % slides.length;
      let attempts = 0;
      while (slides[next].classList.contains("hidden") && attempts < slides.length) {
        next = (next + 1) % slides.length;
        attempts++;
      }
      if (!slides[next].classList.contains("hidden")) show(next);
    }, 4000);
    cardTimers.push(timer);

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        clearInterval(timer);
        cardTimers = cardTimers.filter((id) => id !== timer);
        show(parseInt(dot.dataset.index || "0", 10));
        const restarted = setInterval(() => show((idx + 1) % slides.length), 4000);
        cardTimers.push(restarted);
      });
    });
  }

  function render() {
    const people = Math.max(1, Math.min(20, parseInt(peopleInput.value, 10) || 1));
    const selectedOption = guideLangSelect.value;
    const withGuide = selectedOption !== "noGuide";

    const visible = TOURS.filter((t) => {
      if (selectedOption !== "noGuide") {
        if (!t.languages?.includes(selectedOption)) return false;
      }
      return true;
    });

    clearCardTimers();
    grid.innerHTML = "";

    if (visible.length === 0) {
      grid.innerHTML = `<p class="col-span-full text-center text-on-surface-variant py-8">No tours match those filters yet — try different options.</p>`;
      return;
    }

    visible.forEach((t) => {
      const total = priceFor(t.pricing, people, withGuide);
      const personLabel = people === 1 ? "person" : "persons";
      const priceLine = total
        ? `Price for ${people} ${personLabel}: ${formatAMD(total)}`
        : `Contact for price`;

      const tourHref = `${base}tours/${t.slug}`;

      let slidesHtml = "";
      let dotsHtml = "";
      if (t.images && t.images.length > 0) {
        t.images.forEach((img, i) => {
          slidesHtml += `<img alt="${t.title}" loading="lazy" class="card-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${i === 0 ? "opacity-100" : "opacity-0"}" src="${img}">`;
        });
        if (t.images.length > 1) {
          t.images.forEach((_, i) => {
            dotsHtml += `<span class="card-dot h-1.5 rounded-full cursor-pointer transition-all duration-500 ${i === 0 ? "w-6 bg-white" : "w-1.5 bg-white/50"}" data-index="${i}"></span>`;
          });
        }
      }

      const card = document.createElement("div");
      card.className = "group bg-surface border border-border-muted rounded-lg overflow-hidden transition-all hover:shadow-lg hover:-translate-y-1 flex flex-col";
      card.innerHTML = `
        <div class="h-64 relative overflow-hidden bg-surface-container">
          <div class="absolute top-4 left-4 z-20 pointer-events-none">
            <span class="bg-secondary text-white text-caption px-3 py-1 rounded-full uppercase">${t.label}</span>
          </div>

          <a href="${tourHref}" class="block w-full h-full group/slide" aria-label="View ${t.title} itinerary">
            ${slidesHtml}
            <div class="absolute inset-0 bg-black/0 group-hover/slide:bg-black/30 transition-colors duration-300 flex items-center justify-center z-10">
              <span class="opacity-0 group-hover/slide:opacity-100 translate-y-2 group-hover/slide:translate-y-0 transition-all duration-300 bg-white text-primary font-label-md text-label-md px-5 py-2.5 rounded-full flex items-center gap-1.5 shadow-lg">
                View Itinerary <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </span>
            </div>
          </a>

          ${dotsHtml ? `<div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-20 pointer-events-auto">${dotsHtml}</div>` : ""}
        </div>
        <div class="p-6 flex flex-col flex-grow">
          <a href="${tourHref}" class="inline-block">
            <h3 class="font-headline-sm text-primary mb-2 group-hover:text-secondary transition-colors cursor-pointer">${t.title}</h3>
          </a>
          <p class="text-on-surface-variant text-body-md mb-4 flex-grow">${t.desc}</p>
          <p class="text-primary font-label-md text-label-md price-pop">${priceLine}</p>
        </div>
      `;
      grid.appendChild(card);
      initCardSlideshow(card);
    });
  }

  // Event Listeners
  minusBtn.addEventListener("click", () => {
    peopleInput.value = String(Math.max(1, parseInt(peopleInput.value, 10) - 1));
    render();
  });
  plusBtn.addEventListener("click", () => {
    peopleInput.value = String(Math.min(20, parseInt(peopleInput.value, 10) + 1));
    render();
  });
  peopleInput.addEventListener("input", render);
  guideLangSelect.addEventListener("change", render);

  render();
</script>


<!-- Reviews Section -->
<section class="py-section-padding px-margin-desktop max-w-container-max mx-auto" id="reviews">
<div class="text-center mb-16">
<span class="text-secondary font-label-md text-label-md tracking-widest uppercase mb-2 block" data-t="reviews_subtitle">Testimonials</span>
<h2 class="text-headline-md font-headline-md text-primary mb-4" style="font-family: 'Source Serif 4', serif;" data-t="reviews_title">What Our Guests Say</h2>
<div class="w-12 h-1 bg-secondary mx-auto mb-6"></div>
<p class="text-on-surface-variant max-w-2xl mx-auto text-body-md" data-t="reviews_desc">Real stories from travelers who explored Armenia with us.</p>
</div>

<!-- Testimonials -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-16" id="testimonial-grid">
  {[
    // reviews here
   ].map((r) => (
    <div class="bg-surface border border-border-muted rounded-lg p-8 flex flex-col">
      <div class="flex gap-1 text-secondary mb-4">
        <span class="material-symbols-outlined text-[18px]">star</span>
        <span class="material-symbols-outlined text-[18px]">star</span>
        <span class="material-symbols-outlined text-[18px]">star</span>
        <span class="material-symbols-outlined text-[18px]">star</span>
        <span class="material-symbols-outlined text-[18px]">star</span>
      </div>
      <p class="text-on-surface font-body-md text-body-md leading-relaxed mb-6 flex-grow" style="font-family: 'Source Serif 4', serif;">&ldquo;{r.quote}&rdquo;</p>
      <div class="flex items-center gap-3 pt-4 border-t border-border-muted">
        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-label-md text-label-md shrink-0">
          {r.name.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase()}
        </div>
        <div>
          <p class="font-label-md text-label-md text-primary">{r.name}</p>
          <p class="text-caption text-on-surface-variant">{r.trip}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<!-- Share Experience CTA -->
<div class="bg-primary rounded-2xl p-8 md:p-12 text-center relative overflow-hidden">
<div class="absolute inset-0 bg-white/5 backdrop-blur-sm"></div>
<div class="relative z-10">
<h3 class="text-white font-headline-md mb-2" data-t="review_form_title">Share Your Experience</h3>
<p class="text-white/80 max-w-xl mx-auto mb-8" data-t="review_form_desc">How was your journey? Your feedback helps us grow and helps others discover Armenia.</p>
<form class="max-w-xl mx-auto text-left space-y-6">
<div class="flex flex-col items-center gap-2 mb-4">
  <label class="text-white/90 text-label-md uppercase tracking-wider" data-t="label_rating">Your Rating</label>
  
  <input type="hidden" id="review-rating" name="rating" value="5">
  
  <div class="flex gap-1" id="star-container">
    <span class="star-btn material-symbols-outlined cursor-pointer hover:scale-110 transition-transform text-secondary-container" data-value="1" style="font-variation-settings: 'FILL' 1;">star</span>
    <span class="star-btn material-symbols-outlined cursor-pointer hover:scale-110 transition-transform text-secondary-container" data-value="2" style="font-variation-settings: 'FILL' 1;">star</span>
    <span class="star-btn material-symbols-outlined cursor-pointer hover:scale-110 transition-transform text-secondary-container" data-value="3" style="font-variation-settings: 'FILL' 1;">star</span>
    <span class="star-btn material-symbols-outlined cursor-pointer hover:scale-110 transition-transform text-secondary-container" data-value="4" style="font-variation-settings: 'FILL' 1;">star</span>
    <span class="star-btn material-symbols-outlined cursor-pointer hover:scale-110 transition-transform text-secondary-container" data-value="5" style="font-variation-settings: 'FILL' 1;">star</span>
  </div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div class="flex flex-col gap-1.5">
<label class="text-white/90 text-label-md uppercase tracking-wider" data-t="label_name">Your Name</label>
<input class="bg-white/10 border-white/20 rounded-lg p-3 text-white placeholder:text-white/40 focus:ring-2 focus:ring-secondary-container outline-none" placeholder="Alex Johnson" type="text">
</div>
