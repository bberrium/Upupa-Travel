---
import TourLayout from "../../layouts/TourLayout.astro";
import { TOURS } from "../../data/tours.js";

const tour = TOURS.find((t) => t.slug === "garni-geghard")!;

// Image paths are local (see /public/images/tours/...). Run
// `npm run images:fetch` once to pull them in, or drop your own files at these
// paths — anything missing falls back to a neutral placeholder.
const days = [
  {
    dayNumber: "01",
    title: "Garni Temple, Symphony of Stones, Geghard Monastery, Lavash Baking",
    subtitle: "Pre-Christian Roots & Volcanic Geology",
    stops: [
      {
        time: "15-20 minutes",
        title: "Charents' Arch",
        desc: "A scenic viewpoint offering one of the most spectacular panoramic views of Mount Ararat. Built in 1957 and named after the famous Armenian poet Yeghishe Charents, the arch is a favorite spot for photographers and nature lovers.",
        images: [
          "images/tours/garni-geghard/arch1.webp",
          "images/tours/garni-geghard/arch2.webp",
        ],
      },
      {
        time: "60 minutes",
        title: "Geghard Monastery",
        desc: "A UNESCO World Heritage Site and one of Armenia's most remarkable medieval monasteries. Founded in the 4th century by Saint Gregory the Illuminator, the monastery is famous for its churches carved directly into the surrounding cliffs. Its name, Geghard, means \"spear\", referring to the Holy Lance believed to have pierced the side of Jesus Christ. Surrounded by dramatic mountains, Geghard is a masterpiece of Armenian architecture and spirituality.",
        images: [
          "images/tours/garni-geghard/monastery1.webp",
          "images/tours/garni-geghard/monastery2.webp",
          "images/tours/garni-geghard/monastery3.webp",
        ],
      },
      {
        time: "40 minutes",
        title: "Symphony of Stones (Garni Canyon)",
        desc: "A breathtaking natural formation of hexagonal basalt columns created by ancient volcanic lava. Located in the Azat River Gorge, it is one of Armenia's most impressive geological landmarks.",
        images: [
          "images/tours/garni-geghard/stones1.webp",
          "images/tours/garni-geghard/stones2.webp",
          "images/tours/garni-geghard/stones3.webp",
        ],
      },
      {
        time: "60 minutes",
        title: "Garni Temple",
        desc: "Armenia's only surviving pagan temple, built in the 1st century AD. This magnificent Greco-Roman monument offers breathtaking views over the Azat River Gorge and provides a unique glimpse into Armenia's pre-Christian history.",
        images: [
          "images/tours/garni-geghard/garni2.webp",
          "images/tours/garni-geghard/garni4.webp",
        ],
      },
      {
        time: "40 minutes",
        title: "Lavash baking",
        desc: "A stop at a village home to watch lavash being baked in a tonir — the clay oven sunk into the floor — and to taste it straight off the wall of the oven with local cheese and herbs.",
        images: [
          "images/tours/garni-geghard/lavash1.webp",
          "images/tours/garni-geghard/lavash2.webp",
          "images/tours/garni-geghard/lavash3.webp",
          "images/tours/garni-geghard/lavash4.webp",
        ],
      },
    ],
  },
];

const included = [
  "Private vehicle and driver for the whole route",
  "English, Russian or Armenian speaking guide (when selected)",
  "Admission tickets to Garni Temple and Geghard Monastery",
  "Hotel pickup and drop-off in Yerevan",
];

const notIncluded = [
  "Lunch and drinks",
  "Lavash baking experience if booked separately",
  "Tips for the guide or driver",
];

const tips = [
  {
    icon: "hiking",
    title: "Footwear",
    desc: "Wear comfortable walking shoes with good grip — some paths are uneven, rocky and can be slippery after rain.",
  },
  {
    icon: "checkroom",
    title: "Monastery dress code",
    desc: "Shoulders and knees covered inside Geghard. A light scarf is enough.",
  },
  {
    icon: "thermostat",
    title: "Gorge temperature",
    desc: "The Azat gorge stays cooler than Yerevan even in summer. Bring a light layer.",
  },
];

// 1. List the filenames of any images that are too low-quality for the big screen
const lowResImages = [
  "images/tours/garni-geghard/arch1.webp",
  "images/tours/garni-geghard/arch2.webp",// Add any others here!
  "images/tours/garni-geghard/garni3.webp",
  "public/images/tours/garni-geghard/garni4.webp",
  "public/images/tours/garni-geghard/monastery3.webp"

];

// 2. Flatten the itinerary images, but filter OUT the ones in the list above
const allItineraryImages = days
  .flatMap(day => day.stops.flatMap(stop => stop.images || []))
  .filter(img => !lowResImages.includes(img));
---

<TourLayout
  label={tour.label}
  tourNumber={tour.tourNumber}
  title={tour.title}
  summary={tour.desc}
  heroImage={allItineraryImages[0]}
  images={allItineraryImages}
  duration={tour.duration}
  region={tour.region}
  languages={tour.languages}
  pricing={tour.pricing}
  days={days}
  included={included}
  notIncluded={notIncluded}
  tips={tips}
/>