---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourSearch from "../../components/TourSearch.astro";
import { TOURS } from "../../data/tours.js";

const base = import.meta.env.BASE_URL;
const hasMultiDay = TOURS.some((tour) => tour.category === "multi");
---

<BaseLayout
  title="Multi-Day Tours in Armenia — Upupa Travel"
  current="tours"
  description="Private multi-day journeys across Armenia, from Syunik and Tatev to the northern monasteries, with accommodation arranged around your pace."
>
  <section class="border-b border-border-muted bg-surface-container-low/60 py-14 md:py-20">
    <div class="container-page text-center">
      <span class="eyebrow">Multi-Day Tours</span>
      <h1 class="font-display text-display-lg-mobile font-display-lg text-balance text-primary md:text-display-lg">
        Go deeper, stay longer
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-body-lg text-on-surface-variant">
        Two to four days across the country, at a pace that leaves room for the places you didn't
        plan for.
      </p>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      {hasMultiDay ? (
        <TourSearch category="multi" />
      ) : (
        <!-- Honest empty state. A nav link that lands on "no results" reads as
             a broken site; this reads as a service that's being scheduled. -->
        <div class="panel mx-auto max-w-2xl p-8 text-center md:p-12">
          <span class="material-symbols-outlined text-[40px] text-secondary">event_upcoming</span>
          <h2 class="font-display mt-3 text-headline-md font-headline-md text-primary">
            Multi-day routes are booked on request
          </h2>
          <p class="mx-auto mt-4 max-w-lg text-body-md text-on-surface-variant">
            Our fixed multi-day itineraries are being finalised. In the meantime we build 2-4 day
            journeys to order — Tatev and Syunik in the south, Lori and Debed in the north, or the
            wine country of Vayots Dzor — including accommodation and all transport.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a class="btn-primary" href={`${base}custom-tour`}>Plan a multi-day route</a>
            <a class="btn-outline" href={`${base}tours/day-tours`}>Browse day tours</a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
