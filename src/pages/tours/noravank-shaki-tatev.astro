---
import TourLayout from "../../layouts/TourLayout.astro";
import { TOURS } from "../../data/tours.js";

const tour = TOURS.find((t) => t.slug === "noravank-shaki-tatev")!;

// Photos live in /public/images/tours/noravank-shaki-tatev/ and are numbered
// (noravank1-10, shaki1-9, tatev1-32). photos("tatev", 9, 24) builds the paths
// for tatev9.webp ... tatev24.webp, so re-slicing a stop is a one-number change.
const dir = "images/tours/noravank-shaki-tatev";
const photos = (name: string, from: number, to: number) =>
  Array.from({ length: to - from + 1 }, (_, i) => `${dir}/${name}${from + i}.webp`);

const days = [
  {
    dayNumber: "01",
    title: "Noravank, Shaki Waterfall, Wings of Tatev Ropeway, Tatev Monastery",
    subtitle: "Red Cliffs, Hidden Waterfalls & the Medieval Heights of Syunik",
    stops: [
      {
        time: "60 minutes",
        title: "Noravank Monastery",
        desc: "A masterpiece of 13th-century medieval Armenian architecture, dramatically nestled at the end of a winding gorge carved by the Amaghu River. The complex is renowned for its landscape of towering, sheer brick-red cliffs. Its most iconic structure is the two-story Surb Astvatsatsin (Holy Mother of God) Church, crafted by the legendary master sculptor and architect Momik. The site is also celebrated for its intricate stone carvings, including a rare medieval relief that depicts God the Father.",
        images: photos("noravank", 1, 10),
      },
      {
        time: "40-50 minutes",
        title: "Shaki Waterfall",
        desc: "One of the most beautiful natural sights in southern Armenia's Syunik Province. The water drops 18 meters down a wall of dark volcanic rock, creating a stunning view. It is hidden inside a deep gorge near the town of Sisian, surrounded by ancient caves and green nature.",
        images: photos("shaki", 1, 8),
      },
      {
        time: "60 minutes",
        title: "Lunch stop",
        desc: "Optional lunch at the Halidzor ropeway station before the ride across the gorge.",
        images: [...photos("tatev", 24, 24), ...photos("tatev", 7, 8)],        
      },
      {
        time: "20 minutes",
        title: "Wings of Tatev Ropeway",
        desc: "The world's longest non-stop double-track cable car, spanning 5.7 kilometers (3.5 miles) across the spectacular Vorotan River Gorge. Reaching speeds of up to 37 km/h (23 mph), the ropeway connects the village of Halidzor with the medieval Tatev Monastery complex, turning a winding 40-minute drive into a scenic 12-minute flight. It is both a breathtaking attraction and a year-round transit link for local residents.",
        images: [...photos("tatev", 4, 4), ...photos("tatev", 31, 32), ...photos("tatev", 3, 3)],
      },
      {
        time: "70-80 minutes",
        title: "Tatev Monastery & viewpoint above the monastic complex",
        desc: "A famous 9th-century Armenian complex built on a high stone plateau in southern Syunik Province. It sits dramatically on the edge of the deep Vorotan Gorge, surrounded by green mountains and impressive cliffs. For centuries it was a major spiritual, cultural and educational center for the region, home to a famous medieval university. Many visitors arrive by riding the Wings of Tatev.",
        images: [...photos("tatev", 5, 6), ...photos("tatev", 10, 12), ...photos("tatev", 14, 18), ...photos("tatev", 20, 23), ...photos("tatev", 26, 30)],
      },
      {
        time: "30-40 minutes",
        title: "Harsnadzor Watchtower",
        desc: "A historic medieval outpost perched on the edge of the Vorotan River Gorge. It was a vital link in an ancient defensive warning system protecting Syunik from invaders: guards who spotted an enemy rang a massive bell hung from the stone rotunda to alert nearby Tatev Monastery. Today it is a popular stop with sweeping panoramic views of the canyon below.",
        images: [...photos("tatev", 33, 33), ...photos("tatev", 35, 36)],
      },
    ],
  },
];


// DRAFT: the client left this section blank. Confirm before going live,
// especially whether ropeway tickets are included.
const included = [
  "Private vehicle and driver for the whole route",
  "English, Russian or Armenian speaking guide (when selected)",
  "Hotel pickup and drop-off in Yerevan",
];

const notIncluded = [
  "Lunch and drinks",
  "Tips for the guide or driver",
];

// DRAFT: the client left this section blank.
const tips = [
  {
    icon: "hiking",
    title: "Footwear",
    desc: "Wear comfortable walking shoes with good grip. Paths at Shaki Waterfall and around Tatev are uneven and can be wet.",
  },
  {
    icon: "checkroom",
    title: "Monastery dress code",
    desc: "Shoulders and knees covered inside Noravank and Tatev. A light scarf is enough.",
  },
  {
    icon: "schedule",
    title: "A long day",
    desc: "This is a 14-15 hour tour with long drives. Bring water, snacks and a light layer.",
  },
];

// 1. List the paths of any images that are too low-quality for the big screen
const lowResImages: string[] = [];

// 2. Hero carousel uses the curated card images, minus the low-res ones
const heroImages = tour.images.filter((img) => !lowResImages.includes(img));
---

<TourLayout
  label={tour.label}
  tourNumber={tour.tourNumber}
  title={tour.title}
  summary={tour.desc}
  heroImage={heroImages[0]}
  images={heroImages}
  duration={tour.duration}
  region={tour.region}
  languages={tour.languages}
  pricing={tour.pricing}
  days={days}
  included={included}
  notIncluded={notIncluded}
  tips={tips}
/>