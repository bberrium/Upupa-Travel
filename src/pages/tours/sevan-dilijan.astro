---
import TourLayout from "../../layouts/TourLayout.astro";
import { TOURS } from "../../data/tours.js";

const tour = TOURS.find((t) => t.slug === "sevan-dilijan")!;

const days = [
  {
    dayNumber: "01",
    title: "Lake Sevan & Tavush Province",
    subtitle: "The Blue Pearl & Armenian Switzerland",
    stops: [
      {
        time: "Arrival",
        title: "Lake Sevan",
        desc: "Lake Sevan is the Blue Pearl of Armenia. Located almost 1,900 meters above sea level, it is the largest lake in the country and one of the highest large freshwater lakes in the world, surrounded by mountains and open skies.",
        images: [
          "images/tours/sevan-dilijan/sevan1.webp",
          "images/tours/sevan-dilijan/sevan2.webp",
        ],
      },
      {
        time: "60 minutes",
        title: "Sevanavank Monastery",
        desc: "Sevanavank is one of the most famous medieval monasteries in Armenia, located on a rocky peninsula overlooking Lake Sevan. Founded in 874 AD by Princess Mariam, it originally stood on an island when the lake's water level was higher. Today the monastery is known for its two surviving churches, Surp Arakelots and Surp Astvatsatsin, and for its panoramic views.",
        images: [
          "images/tours/sevan-dilijan/sevanavank1.webp",
          "images/tours/sevan-dilijan/sevanavank2.webp",
          "images/tours/sevan-dilijan/sevanavank3.webp",
          "images/tours/sevan-dilijan/sevanavank4.webp",
          "images/tours/sevan-dilijan/sevanavank5.webp",
        ],
      },
      {
        time: "40 minutes",
        title: "Dilijan",
        desc: "Dilijan is one of the greenest and most picturesque towns in Armenia. Surrounded by thick forests and mountains, it is known for its clean air, quiet streets and traditional architecture — which is why it is often called the Armenian Switzerland.",
        images: [
          "images/tours/sevan-dilijan/dilijan2.webp",
          "images/tours/sevan-dilijan/dilijan3.webp",
          "images/tours/sevan-dilijan/dilijan4.webp",
          "images/tours/sevan-dilijan/dilijan5.webp",
          "images/tours/sevan-dilijan/dilijan6.webp",
          "images/tours/sevan-dilijan/dilijan7.webp",
          "images/tours/sevan-dilijan/dilijan8.webp",
        ],
      },
      {
        time: "50-60 minutes",
        title: "Lunch stop",
        desc: "Optional lunch at a traditional local restaurant, at your own expense.",
      },
      {
        time: "60 minutes",
        title: "Goshavank Monastery",
        desc: "Goshavank Monastery sits in the village of Gosh, surrounded by the green forests of Tavush. Founded in the 12th century by the scholar and monk Mkhitar Gosh, it became an important religious, educational and cultural centre of medieval Armenia.",
        images: [
          "images/tours/sevan-dilijan/goshavank.webp",
          "images/tours/sevan-dilijan/goshavank2.webp",
          "images/tours/sevan-dilijan/goshavank3.webp",
          "images/tours/sevan-dilijan/goshavank4.webp",
          "images/tours/sevan-dilijan/goshavank5.webp",
          "images/tours/sevan-dilijan/goshavank6.webp",
          "images/tours/sevan-dilijan/goshavank8.webp",
          "images/tours/sevan-dilijan/goshavank9.webp",
          "images/tours/sevan-dilijan/goshavank10.webp",
          "images/tours/sevan-dilijan/goshavank11.webp",
          "images/tours/sevan-dilijan/goshavank12.webp",
        ],
      },
      {
        time: "60 minutes",
        title: "Haghartsin Monastery",
        desc: "Haghartsin Monastery is hidden in the forests of Tavush Province near Dilijan. Founded in the 10th-11th centuries and at its height in the 12th-13th, the complex includes several churches, chapels and a refectory, and is known for the elegant Church of the Holy Mother of God (Surb Astvatsatsin).",
        images: [
          "images/tours/sevan-dilijan/haghartsin1.webp",
          "images/tours/sevan-dilijan/haghartsin2.webp",
          "images/tours/sevan-dilijan/haghartsin3.webp",
          "images/tours/sevan-dilijan/haghartsin4.webp",
          "images/tours/sevan-dilijan/haghartsin5.webp",
          "images/tours/sevan-dilijan/haghartsin6.webp",
          "images/tours/sevan-dilijan/haghartsin7.webp",
          "images/tours/sevan-dilijan/haghartsin8.webp",
          "images/tours/sevan-dilijan/haghartsin9.webp",
        ],
      },
    ],
  },
];

const included = [
  "Private transportation for the whole day",
  "English, Russian or Armenian speaking guide (when selected)",
  "All entrance fees and local taxes",
  "Hotel pickup and drop-off in Yerevan",
];

const notIncluded = ["Lunch and drinks", "Boat trips on Lake Sevan", "Tips for the guide or driver"];

const tips = [
  {
    icon: "thermostat",
    title: "Weather prep",
    desc: "Lake Sevan and Dilijan are noticeably cooler and windier than Yerevan. Bring a light jacket even in summer.",
  },
  {
    icon: "hiking",
    title: "Footwear",
    desc: "The climb to Sevanavank is about 200 stone steps. Comfortable shoes make the day much easier.",
  },
  {
    icon: "schedule",
    title: "Long day",
    desc: "This route runs 9-10 hours door to door. Tell us if you'd prefer a shorter version and we'll trim a stop.",
  },
];

const allItineraryImages = days.flatMap(day => day.stops.flatMap(stop => stop.images || []));

---


<TourLayout
  label={tour.label}
  title={tour.title}
  summary={tour.desc}
  heroImage={allItineraryImages[0]}
  images={allItineraryImages}
  duration={tour.duration}
  region={tour.region}
  languages={tour.languages}
  pricing={tour.pricing}
  days={days}
  included={included}
  notIncluded={notIncluded}
  tips={tips}
/>
