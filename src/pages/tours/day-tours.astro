---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourSearch from "../../components/TourSearch.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Day Tours in Armenia — Upupa Travel"
  current="tours"
  description="One-day private tours from Yerevan: Garni, Geghard, Lake Sevan, Dilijan and more, with an English, Russian or Armenian speaking guide."
>
  <section class="border-b border-border-muted bg-surface-container-low/60 py-14 md:py-20">
    <div class="container-page text-center">
      <span class="eyebrow">Day Tours</span>
      <h1 class="font-display text-display-lg-mobile font-display-lg text-balance text-primary md:text-display-lg">
        One day, one route, all yours
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-body-lg text-on-surface-variant">
        Private one-day trips from Yerevan to Armenia's most striking landmarks — back in the city by
        evening.
      </p>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <TourSearch category="day" />
      <p class="mt-10 text-center text-body-md text-on-surface-variant">
        Want to combine two of these, or add a stop?
        <a class="text-secondary underline underline-offset-4" href={`${base}custom-tour`}>Ask for a custom route</a>.
      </p>
    </div>
  </section>
</BaseLayout>
