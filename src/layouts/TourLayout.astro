---
import BaseLayout from "./BaseLayout.astro";
import Picture from "../components/Picture.astro";
import { image } from "../lib/images.js";
import { SITE } from "../lib/site.js";
import { priceFor, formatAMD, approxUSD } from "../data/tours.js";

export interface Stop {
  time: string;
  title: string;
  desc: string;
  image?: string;
  images?: string[];
}
export interface Day {
  dayNumber: string;
  title: string;
  subtitle: string;
  stops: Stop[];
}
export interface Tip {
  icon: string;
  title: string;
  desc: string;
}
export interface PricingTable {
  [count: number]: number;
  extraPerPerson: number;
  maxPeople: number;
}
export interface Pricing {
  noGuide?: PricingTable;
  guide?: PricingTable;
}

interface Props {
  label: string;
  tourNumber?: number;
  title: string;
  summary: string;
  heroImage: string;
  images?: string[];
  duration?: string;
  region?: string;
  pricing?: Pricing | null;
  days: Day[];
  included: string[];
  notIncluded?: string[];
  tips: Tip[];
}

const {
  label,
  tourNumber,
  title,
  summary,
  heroImage,
  images = [],
  duration,
  region,
  pricing = null,
  days,
  included,
  notIncluded = ["Meals and drinks", "Personal expenses", "Tips for the guide or driver"],
  tips,
} = Astro.props;

const slideImages = images.length > 0 ? images : heroImage ? [heroImage] : [];
const resolvedSlides = slideImages.map((src) => image(src));
const base = import.meta.env.BASE_URL;

const fromPrice = priceFor(pricing, 2, false);

const schema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: title,
  description: summary,
  touristType: "Private tour",
  provider: { "@type": "TravelAgency", name: SITE.name, url: SITE.url },
  itinerary: {
    "@type": "ItemList",
    itemListElement: days.flatMap((day, dayIndex) =>
      day.stops.map((stop, stopIndex) => ({
        "@type": "ListItem",
        position: dayIndex * 100 + stopIndex + 1,
        item: { "@type": "TouristAttraction", name: stop.title, description: stop.desc },
      }))
    ),
  },
  ...(fromPrice
    ? {
        offers: {
          "@type": "Offer",
          price: fromPrice,
          priceCurrency: "AMD",
          description: "Total price for a private group of two, without a guide",
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<BaseLayout
  title={`${title} — Upupa Travel`}
  description={summary}
  current="tours"
  ogImage={resolvedSlides[0]?.missing ? "images/hero/02-highlands.webp" : slideImages[0]}
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav class="container-page pt-6 text-caption font-caption text-on-surface-variant" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-primary" href={base}>Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="hover:text-primary" href={`${base}tours/day-tours`}>Tours</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-on-surface">{title}</li>
    </ol>
  </nav>

  <!-- Title -->
  <section class="container-page pb-8 pt-6">
    <div class="max-w-3xl">
      {tourNumber && (
        <p class="mb-2 text-label-md font-label-md uppercase tracking-widest text-secondary">Tour {tourNumber}</p>
      )}
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-secondary px-3 py-1 text-caption font-caption uppercase tracking-wide text-white">{label}</span>
        {duration && (
          <span class="inline-flex items-center gap-1 text-label-md font-label-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[16px]">schedule</span>{duration}
          </span>
        )}
        {region && (
          <span class="inline-flex items-center gap-1 text-label-md font-label-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[16px]">location_on</span>from {region}
          </span>
        )}
      </div>

      <h1 class="font-display text-display-lg-mobile font-display-lg leading-tight text-balance text-primary md:text-display-lg">
        {title}
      </h1>
      <p class="mt-4 text-body-lg text-on-surface-variant">{summary}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#price-calc" class="btn-primary sm:w-auto">Check price &amp; book</a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-outline sm:w-auto">
          <span class="material-symbols-outlined text-[20px]">chat</span> Ask a question
        </a>
      </div>
    </div>
  </section>


  <!-- Content -->
  <section id="itinerary" class="container-page pb-16 md:pb-section-padding">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-gutter">
      <!-- Itinerary -->
      <div class="lg:col-span-8">
        <div class="mb-8 border-b border-border-muted pb-3">
          <h2 class="section-title">Detailed Itinerary</h2>
        </div>

        {days.map((day) => (
          <div class="mb-14">
            <div class="mb-8 flex items-center gap-4">
              <div>
                <h3 class="font-display text-headline-sm font-headline-sm text-on-surface">{day.title}</h3>
                <p class="text-label-md font-label-md text-on-surface-variant">{day.subtitle}</p>
              </div>
            </div>

            <div class="itin-line relative pl-8">
              <div class="absolute bottom-0 left-0 top-0 w-px bg-border-muted"></div>
              <div class="itin-fill absolute left-0 top-0 w-px bg-secondary transition-[height] duration-500 ease-out" style="height: 0px;"></div>
              <div class="space-y-10">
                {day.stops.map((stop) => {
                  const stopImages = stop.images?.length ? stop.images : stop.image ? [stop.image] : [];
                  return (
                    <div class="relative">
                      <span class="itin-dot absolute -left-[2.35rem] top-1 h-4 w-4 rounded-full bg-border-muted transition-all duration-500"></span>
                      <h4 class="mb-2 text-label-md font-label-md uppercase tracking-wide text-secondary">
                        {stop.time} — {stop.title}
                      </h4>
                      <p class="mb-4 text-body-md text-on-surface-variant">{stop.desc}</p>
                      {stopImages.length > 0 && (
                        <div class={`grid gap-2 ${stopImages.length === 2 ? "grid-cols-2" : "grid-cols-2 sm:grid-cols-3"}`}>
                          {stopImages.map((src) => (
                            <div class="aspect-[4/3] overflow-hidden rounded-lg border border-border-muted">
                              <Picture
                                src={src}
                                alt={stop.title}
                                width={600}
                                height={450}
                                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105 motion-reduce:transform-none"
                                sizes="(max-width: 640px) 50vw, 240px"
                              />
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <div class="flex flex-col rounded-2xl bg-primary p-6 shadow-card sm:p-8" id="price-calc" data-pricing={JSON.stringify(pricing)}>
            <h2 class="font-display text-headline-md font-headline-md text-white">Check Price</h2>
            <p class="mb-7 mt-2 text-body-md text-white/75">
              Total for the whole group, not per person. Adjusts for group size and guide.
            </p>

            <div class="mb-6">
              <label class="field-label flex items-center gap-1.5 text-white" for="pc-people">
                Number of people
              </label>
              <div class="flex items-center gap-3">
                <button type="button" id="pc-minus" class="h-11 w-11 rounded-lg border border-white/20 bg-white/10 text-xl text-white transition-colors hover:bg-white/20" aria-label="One fewer person">−</button>
                <input
                  id="pc-people"
                  name="people"
                  type="number"
                  inputmode="numeric"
                  min="1"
                  max="20"
                  value="2"
                  class="field-on-dark w-20 text-center [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                />
                <button type="button" id="pc-plus" class="h-11 w-11 rounded-lg border border-white/20 bg-white/10 text-xl text-white transition-colors hover:bg-white/20" aria-label="One more person">+</button>
              </div>
            </div>

            <div class="mb-6">
              <label class="field-label text-white" for="pc-guide">Guide</label>
              <select id="pc-guide" name="guide" class="field-on-dark">
                <option value="noGuide">No guide</option>
                <option value="guide:en">Guide — English</option>
                <option value="guide:ru">Guide — Russian</option>
                <option value="guide:am">Guide — Armenian</option>
              </select>
            </div>

            <div class="mb-7">
              <label class="field-label flex items-center gap-2 text-white" for="pc-vehicle">
                <span>Vehicle</span>
                <a href={`${base}gallery`} class="normal-case text-secondary-container underline underline-offset-4">photos</a>
              </label>
              <select id="pc-vehicle" name="vehicle" class="field-on-dark">
                <option value="sedan">Comfort sedan (up to 3)</option>
                <option value="minivan">Minivan (up to 6)</option>
                <option value="minibus">Minibus (up to 14)</option>
                <option value="sprinter">Sprinter (up to 19)</option>
              </select>
            </div>

            <div class="mt-auto">
              <div class="flex items-end justify-between gap-4 border-t border-white/20 pb-5 pt-5">
                <p class="text-caption font-caption uppercase tracking-wider text-white/70" id="pc-label">
                  Total for 2 persons
                </p>
                <div class="text-right">
                  <p class="font-display text-headline-sm font-headline-sm text-white" id="pc-total">
                    {fromPrice ? formatAMD(fromPrice) : "Contact for price"}
                  </p>
                  <p class="text-caption font-caption text-white/60" id="pc-usd">
                    {fromPrice ? `${approxUSD(fromPrice)} approx.` : ""}
                  </p>
                </div>
              </div>

              <p class="mb-4 text-caption font-caption text-white/60">
                Larger vehicles are an estimate and are confirmed by email before you pay anything.
              </p>

              <a href={`${base}#contact`} class="btn-primary btn-block">Request this date</a>
              <a href={SITE.whatsapp} target="_blank" rel="noopener" class="mt-3 block text-center text-label-md font-label-md text-white/80 underline underline-offset-4 hover:text-white">
                Or message us on WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Included / not included / tips -->
    <div class="mt-10 grid grid-cols-1 gap-gutter md:grid-cols-3">
      <div class="panel-muted p-7">
        <h2 class="font-display mb-5 text-headline-sm font-headline-sm text-primary">What's included</h2>
        <ul class="space-y-3">
          {included.map((item) => (
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px] text-secondary">check_circle</span>
              <span class="text-body-md text-on-surface-variant">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="panel-muted p-7">
        <h2 class="font-display mb-5 text-headline-sm font-headline-sm text-primary">Not included</h2>
        <ul class="space-y-3">
          {notIncluded.map((item) => (
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px] text-on-surface-variant">remove_circle_outline</span>
              <span class="text-body-md text-on-surface-variant">{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-caption font-caption text-on-surface-variant">
          Deposit and cancellation terms: <a class="text-secondary underline underline-offset-4" href={`${base}terms`}>read here</a>.
        </p>
      </div>

      <div class="panel-muted p-7">
        <h2 class="font-display mb-5 text-headline-sm font-headline-sm text-primary">Know before you go</h2>
        <div class="space-y-5">
          {tips.map((tip) => (
            <div class="flex gap-4">
              <span class="h-fit rounded-lg bg-surface-container-lowest p-2">
                <span class="material-symbols-outlined text-primary">{tip.icon}</span>
              </span>
              <div>
                <h3 class="text-label-md font-label-md uppercase tracking-wide text-primary">{tip.title}</h3>
                <p class="text-body-md text-on-surface-variant">{tip.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <!-- Mobile booking bar.
       On a phone the price calculator sits below a very long itinerary, so the
       price and the call to action were effectively invisible. This keeps both
       one thumb away at all times. -->
  <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-border-muted bg-surface-container-lowest shadow-[0_-6px_24px_rgba(26,28,30,0.12)] lg:hidden"
    style="padding-bottom: env(safe-area-inset-bottom);"
  >
    <div class="flex items-center gap-3 px-margin-mobile py-3">
      <div class="min-w-0">
        <p class="truncate text-caption font-caption uppercase tracking-wide text-on-surface-variant" id="mb-label">
          Total for 2 persons
        </p>
        <p class="font-display truncate text-headline-sm font-headline-sm text-primary" id="mb-total">
          {fromPrice ? formatAMD(fromPrice) : "Contact for price"}
        </p>
      </div>
      <a href="#price-calc" class="btn-primary ml-auto shrink-0 px-5 py-3">Check price</a>
    </div>
  </div>
  <!-- keeps the fixed bar from covering the end of the page -->
  <div class="h-24 lg:hidden" aria-hidden="true"></div>
</BaseLayout>

<script>
  import { priceFor, formatAMD, approxUSD } from "../data/tours.js";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --- Hero slideshow ---
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".tour-hero-slide"));
  const dots = Array.from(document.querySelectorAll<HTMLElement>(".tour-hero-dot"));

  if (slides.length > 1) {
    let index = 0;
    let timer: number | undefined;

    function show(next: number) {
      slides[index].classList.replace("opacity-100", "opacity-0");
      dots[index]?.classList.remove("w-8", "bg-white");
      dots[index]?.classList.add("w-1.5", "bg-white/50");
      index = next;
      slides[index].classList.replace("opacity-0", "opacity-100");
      dots[index]?.classList.remove("w-1.5", "bg-white/50");
      dots[index]?.classList.add("w-8", "bg-white");
    }

    function start() {
      timer = window.setInterval(() => show((index + 1) % slides.length), 5000);
    }
    start();

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        if (timer) clearInterval(timer);
        show(parseInt(dot.dataset.index || "0", 10));
        start();
      });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (timer) clearInterval(timer);
      } else {
        start();
      }
    });
  }

  // --- Itinerary route line ---
  document.querySelectorAll<HTMLElement>(".itin-line").forEach((line) => {
    const fill = line.querySelector<HTMLElement>(".itin-fill");
    const stopDots = Array.from(line.querySelectorAll<HTMLElement>(".itin-dot"));
    if (!fill || stopDots.length === 0) return;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      fill.style.height = "100%";
      stopDots.forEach((dot) => dot.classList.replace("bg-border-muted", "bg-secondary"));
      return;
    }

    let deepest = -1;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const i = stopDots.indexOf(entry.target as HTMLElement);
          if (i <= deepest) return;
          deepest = i;
          const lineTop = line.getBoundingClientRect().top;
          const rect = stopDots[deepest].getBoundingClientRect();
          fill.style.height = `${Math.max(0, rect.top - lineTop + rect.height / 2)}px`;
          for (let j = 0; j <= deepest; j += 1) {
            stopDots[j].classList.remove("bg-border-muted");
            stopDots[j].classList.add("bg-secondary", "scale-110");
          }
        });
      },
      { threshold: 0.6, rootMargin: "0px 0px -10% 0px" }
    );
    stopDots.forEach((dot) => observer.observe(dot));
  });

  // --- Price calculator ---
  const calc = document.getElementById("price-calc");
  if (calc) {
    const pricing = JSON.parse(calc.dataset.pricing || "null");
    const peopleInput = document.getElementById("pc-people") as HTMLInputElement;
    const guideSelect = document.getElementById("pc-guide") as HTMLSelectElement;
    const vehicleSelect = document.getElementById("pc-vehicle") as HTMLSelectElement;
    const totalEl = document.getElementById("pc-total");
    const usdEl = document.getElementById("pc-usd");
    const labelEl = document.getElementById("pc-label");

    // Placeholder multipliers until real per-vehicle pricing is supplied.
    const VEHICLE_MULTIPLIERS: Record<string, number> = {
      sedan: 1,
      minivan: 1.15,
      minibus: 1.35,
      sprinter: 1.6,
    };

    let lastTotal: number | null = null;

    function animateTotal(from: number, to: number) {
      if (reduceMotion) {
        if (totalEl) totalEl.textContent = formatAMD(to);
        return;
      }
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / 400);
        const eased = 1 - Math.pow(1 - t, 3);
        if (totalEl) totalEl.textContent = formatAMD(Math.round(from + (to - from) * eased));
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function update() {
      const people = Math.max(1, Math.min(20, parseInt(peopleInput.value, 10) || 1));
      peopleInput.value = String(people);
      const withGuide = guideSelect.value.startsWith("guide:");
      const basePrice = priceFor(pricing, people, withGuide);
      const total =
        basePrice == null
          ? null
          : Math.round((basePrice * VEHICLE_MULTIPLIERS[vehicleSelect.value]) / 100) * 100;

      const peopleLabel = `Total for ${people} ${people === 1 ? "person" : "persons"}`;
      if (labelEl) labelEl.textContent = peopleLabel;
      const barLabel = document.getElementById("mb-label");
      const barTotal = document.getElementById("mb-total");
      if (barLabel) barLabel.textContent = peopleLabel;
      if (barTotal) barTotal.textContent = total == null ? "Contact for price" : formatAMD(total);

      if (total == null) {
        if (totalEl) totalEl.textContent = "Contact for price";
        if (usdEl) usdEl.textContent = "";
      } else {
        if (lastTotal == null && totalEl) totalEl.textContent = formatAMD(total);
        else animateTotal(lastTotal as number, total);
        if (usdEl) usdEl.textContent = `${approxUSD(total)} approx.`;
      }
      lastTotal = total;
    }

    document.getElementById("pc-minus")?.addEventListener("click", () => {
      peopleInput.value = String(Math.max(1, (parseInt(peopleInput.value, 10) || 1) - 1));
      update();
    });
    document.getElementById("pc-plus")?.addEventListener("click", () => {
      peopleInput.value = String(Math.min(20, (parseInt(peopleInput.value, 10) || 1) + 1));
      update();
    });
    peopleInput.addEventListener("input", update);
    guideSelect.addEventListener("change", update);
    vehicleSelect.addEventListener("change", update);
    update();
  }
</script>